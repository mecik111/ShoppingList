<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ShoppingList.Views"
             x:Class="ShoppingList.Views.MainPage"
             Title="Lista Zakupów">

    <Grid RowDefinitions="*, Auto" Padding="10">

        <ScrollView >
            <VerticalStackLayout x:Name="ItemsStackLayout" Spacing="5">
              
            </VerticalStackLayout>
        </ScrollView>


        <Border Grid.Row="1" Padding="10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*, 70, 50, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="5" RowSpacing="5">
                <Label Text="Nowy produkt" Grid.Row="0" Grid.Column="0" FontSize="12"/>
                <Label Text="Jednostka" Grid.Row="0" Grid.Column="1" FontSize="12"/>
                <Label Text="Ilość" Grid.Row="0" Grid.Column="2" FontSize="12"/>

                <Entry x:Name="NewItemNameEntry" Grid.Row="1" Grid.Column="0"/>
                <Entry x:Name="NewItemUnitEntry" Text="szt." Grid.Row="1" Grid.Column="1"/>
                <Entry x:Name="NewItemQuantityEntry" Text="1" Keyboard="Numeric" Grid.Row="1" Grid.Column="2"/>

                <Button Text="Dodaj" Clicked="OnAddItemClicked" Grid.Row="1" Grid.Column="3"/>
            </Grid>
        </Border>
    </Grid>

</ContentPage>